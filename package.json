{
  "name": "r2-explorer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prisma:generate": "yarn workspace @r2-explorer/desktop prisma:generate",
    "prisma:migrate": "yarn workspace @r2-explorer/desktop prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.12"
  }
}
