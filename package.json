{
  "name": "r2-explorer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @r2-explorer/desktop tauri:dev",
    "desktop:run": "yarn workspace @r2-explorer/desktop tauri:dev",
    "dev:web": "yarn workspace @r2-explorer/desktop web:dev",
    "build": "turbo run build",
    "desktop:build": "yarn workspace @r2-explorer/desktop tauri:build",
    "desktop:test": "yarn workspace @r2-explorer/desktop test:desktop",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prisma:generate": "yarn workspace @r2-explorer/desktop prisma:generate",
    "prisma:migrate": "yarn workspace @r2-explorer/desktop prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.12"
  }
}
