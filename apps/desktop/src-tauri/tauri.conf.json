{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vor2",
  "version": "0.1.0",
  "identifier": "com.daxsoft.r2explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn workspace @vor2/desktop web:dev",
    "beforeBuildCommand": "yarn workspace @vor2/desktop build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vor2",
        "width": 1440,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
